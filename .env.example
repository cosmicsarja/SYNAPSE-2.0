# Optional Supabase sync (managed by Lovable / Vercel)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional Gemini Vision API for high-accuracy online Kannada + English OCR
# Get a key from https://aistudio.google.com/apikey and set it in your local .env
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-3-flash-preview

# Optional custom FastAPI OCR backend URL
VITE_OCR_API_URL=
